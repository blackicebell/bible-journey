{
  "expo": {
    "name": "Bible Journey",
    "slug": "bible-journey",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blackicebell.biblejourney"
    },
    "android": {
      "package": "com.blackicebell.biblejourney",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
